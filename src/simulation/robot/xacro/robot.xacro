<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ackermann_robot">

    <xacro:include filename="$(find simulation)/robot/xacro/common_properties.xacro"/>
    <xacro:include filename="$(find simulation)/robot/xacro/chassis.xacro"/>
    <xacro:include filename="$(find simulation)/robot/xacro/sensors.xacro"/>
    <xacro:include filename="$(find simulation)/robot/xacro/control.xacro"/>

</robot>
