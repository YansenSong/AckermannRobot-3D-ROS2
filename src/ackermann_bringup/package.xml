<?xml version="1.0"?>
<package format="3">
  <name>ackermann_bringup</name>
  <version>0.1.0</version>
  <description>Composable mapping, localization, planning, and navigation bringup for the Ackermann robot.</description>
  <maintainer email="zoe@todo.todo">zoe</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ackermann_control</exec_depend>
  <exec_depend>ackermann_gazebo</exec_depend>
  <exec_depend>lio_sam</exec_depend>
  <exec_depend>hdl_localization</exec_depend>
  <exec_depend>hybrid_astar_planner</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
